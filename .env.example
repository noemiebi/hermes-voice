# hermes-voice 설정 예시. 복사해서 .env 로 쓰고 필요한 값만 채운다(.env 는 git에 올리지 않음).

# 헤르메스(OpenAI 호환) API 주소
HERMES_API_URL=http://127.0.0.1:8642
# 헤르메스 api_server 키(필수. config.yaml의 platforms.api_server.extra.key 또는 API_SERVER_KEY)
HERMES_API_KEY=
# 화면·말투에 쓰는 대화 상대 이름(기본 Herbot)
AGENT_NAME=Herbot
# 설정 시트에 보일 빠름/깊게 모델 이름(비우면 생략). 예: Claude Sonnet 5.5 / Claude Opus 5.5
MODEL_LABEL_FAST=
MODEL_LABEL_DEEP=
# TTS 엔진: supertonic(기본) | qwen(별도 .venv-tts 필요, deploy/install-tts.sh)
TTS_ENGINE=supertonic
# 접속 토큰. 비우면 인증 없음. Tailscale 밖에 열 때는 반드시 설정
VOICE_TOKEN=
# /ws에 붙어도 되는 다른 출처(쉼표 구분, 예: https://a.example:8443, 또는 *). 비우면 같은 출처와 Origin 없는 클라이언트만
VOICE_ALLOWED_ORIGINS=
# 서버 포트(기본 8480)
PORT=8480
# 바인드 주소(기본 127.0.0.1, 외부 노출은 tailscale serve로)
HOST=127.0.0.1
# 대화 기록·사용자 독음 사전·STT 교정표 폴더(기본 ~/.hermes/voice)
VOICE_DATA_DIR=
# Supertonic 3 모델 상위 폴더(onnx/, voice_styles/ 포함. 기본 ~/.hermes/voice/models/supertonic3)
SUPERTONIC_DIR=
# onnx 폴더를 따로 둘 때만(기본 $SUPERTONIC_DIR/onnx)
SUPERTONIC_MODEL_DIR=
# Whisper 모델(Hugging Face id, 기본 mlx-community/whisper-large-v3-turbo)
STT_MODEL=mlx-community/whisper-large-v3-turbo
